# Vacciora Environment Configuration

# Server & Database
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/vacciora
JWT_SECRET=vacciora-super-secret-key-uip-production-2026

# Python ML Risk Prediction Microservice
ML_SERVICE_URL=http://localhost:5001

# Twilio Communications (SMS & WhatsApp)
# One SDK, one provider, one set of credentials.
# If these variables are set, real SMS/WhatsApp messages are dispatched.
# If absent or blank, Vacciora seamlessly records them with "mock" delivery status for local dev.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=

# Email Sender (Nodemailer SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vacciora Health" <reminders@vacciora.health>
